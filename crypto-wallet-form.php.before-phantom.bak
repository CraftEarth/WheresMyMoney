<?php

declare(strict_types=1);

require_once __DIR__ . '/includes/bootstrap.php';

require_login();

$pageTitle = 'Add Crypto Wallet';
$pageType = 'app';
$activePage = 'crypto';

$userId = current_user_id();

$errors = [];

$walletType = strtolower(
    trim(
        (string) (
            $_POST['wallet_type']
            ?? $_GET['type']
            ?? 'metamask'
        )
    )
);

if (
    !in_array(
        $walletType,
        [
            'metamask',
            'phantom',
        ],
        true
    )
) {
    $walletType = 'metamask';
}


$walletLabel =
    $walletType === 'phantom'
        ? 'My Phantom'
        : 'My MetaMask';

$evmAddress = '';
$solanaAddress = '';
$bitcoinAddress = '';


if ($_SERVER['REQUEST_METHOD'] === 'POST') {

    $submittedToken =
        (string) (
            $_POST['csrf_token']
            ?? ''
        );

    if (
        !hash_equals(
            csrf_token(),
            $submittedToken
        )
    ) {
        $errors[] =
            'Your session token is invalid. Please try again.';
    }


    $walletLabel = trim(
        (string) (
            $_POST['wallet_label']
            ?? ''
        )
    );


    $evmAddress = trim(
        (string) (
            $_POST['evm_address']
            ?? ''
        )
    );


    $solanaAddress = trim(
        (string) (
            $_POST['solana_address']
            ?? ''
        )
    );


    $bitcoinAddress = trim(
        (string) (
            $_POST['bitcoin_address']
            ?? ''
        )
    );


    if ($walletLabel === '') {
        $errors[] =
            'Wallet label is required.';
    }


    if (
        $evmAddress === '' &&
        $solanaAddress === '' &&
        $bitcoinAddress === ''
    ) {
        $errors[] =
            'Enter at least one public wallet address.';
    }


    /*
     * EVM:
     * Ethereum, Base, Polygon, Arbitrum,
     * BNB Chain, Optimism, etc.
     */
    if (
        $evmAddress !== '' &&
        !preg_match(
            '/^0x[a-fA-F0-9]{40}$/',
            $evmAddress
        )
    ) {
        $errors[] =
            'The EVM address is not valid.';
    }


    /*
     * Solana addresses use Base58.
     */
    if (
        $solanaAddress !== '' &&
        !preg_match(
            '/^[1-9A-HJ-NP-Za-km-z]{32,44}$/',
            $solanaAddress
        )
    ) {
        $errors[] =
            'The Solana address is not valid.';
    }


    /*
     * Broad read-only Bitcoin validation.
     * Supports legacy, SegWit, and Taproot-style addresses.
     */
    if (
        $bitcoinAddress !== '' &&
        !preg_match(
            '/^(bc1|1|3)[a-zA-HJ-NP-Z0-9]{20,90}$/i',
            $bitcoinAddress
        )
    ) {
        $errors[] =
            'The Bitcoin address is not valid.';
    }


    $addresses = [];

    if ($evmAddress !== '') {
        $addresses[] = [
            'type' => 'evm',
            'address' => strtolower(
                $evmAddress
            ),
            'label' => 'EVM',
        ];
    }

    if ($solanaAddress !== '') {
        $addresses[] = [
            'type' => 'solana',
            'address' => $solanaAddress,
            'label' => 'Solana',
        ];
    }

    if ($bitcoinAddress !== '') {
        $addresses[] = [
            'type' => 'bitcoin',
            'address' => $bitcoinAddress,
            'label' => 'Bitcoin',
        ];
    }


    if ($errors === []) {

        foreach ($addresses as $address) {

            $stmt = db()->prepare(
                '
                SELECT
                    g.wallet_label

                FROM crypto_wallet_addresses a

                INNER JOIN crypto_wallet_groups g
                    ON g.id = a.wallet_group_id
                   AND g.user_id = a.user_id

                WHERE a.user_id = :user_id
                  AND a.address_type = :address_type
                  AND a.wallet_address = :wallet_address
                  AND a.address_status = "active"

                LIMIT 1
                '
            );

            $stmt->execute([
                'user_id' =>
                    $userId,

                'address_type' =>
                    $address['type'],

                'wallet_address' =>
                    $address['address'],
            ]);

            $existingWallet =
                $stmt->fetchColumn();

            if ($existingWallet !== false) {

                $errors[] =
                    $address['label']
                    . ' address is already tracked under '
                    . $existingWallet
                    . '.';
            }
        }
    }


    if ($errors === []) {

        $pdo = db();

        $pdo->beginTransaction();

        try {

            $stmt = $pdo->prepare(
                '
                INSERT INTO crypto_wallet_groups (
                    user_id,
                    wallet_type,
                    wallet_label,
                    wallet_status
                )
                VALUES (
                    :user_id,
                    :wallet_type,
                    :wallet_label,
                    "active"
                )
                '
            );

            $stmt->execute([
                'user_id' =>
                    $userId,

                'wallet_type' =>
                    $walletType,

                'wallet_label' =>
                    $walletLabel,
            ]);


            $walletGroupId =
                (int) $pdo->lastInsertId();


            $addressStmt =
                $pdo->prepare(
                    '
                    INSERT INTO crypto_wallet_addresses (
                        user_id,
                        wallet_group_id,
                        address_type,
                        wallet_address,
                        address_label,
                        address_status
                    )
                    VALUES (
                        :user_id,
                        :wallet_group_id,
                        :address_type,
                        :wallet_address,
                        :address_label,
                        "active"
                    )
                    '
                );


            foreach ($addresses as $address) {

                $addressStmt->execute([
                    'user_id' =>
                        $userId,

                    'wallet_group_id' =>
                        $walletGroupId,

                    'address_type' =>
                        $address['type'],

                    'wallet_address' =>
                        $address['address'],

                    'address_label' =>
                        $address['label'],
                ]);
            }


            $pdo->commit();


            header(
                'Location: '
                . url(
                    'crypto.php?wallet_added=1'
                )
            );

            exit;

        } catch (Throwable $exception) {

            if ($pdo->inTransaction()) {
                $pdo->rollBack();
            }

            $errors[] =
                'Unable to save wallet: '
                . $exception->getMessage();
        }
    }
}


require_once APP_ROOT
    . '/includes/header.php';

require_once APP_ROOT
    . '/includes/app-nav.php';

require_once APP_ROOT
    . '/pages/app/crypto-wallet-form.php';

require_once APP_ROOT
    . '/includes/footer.php';
