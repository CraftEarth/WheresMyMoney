.app {
    background: #f4f6fb;
}

.app .site-footer {
    display: none;
}

.app-sidebar {
    position: fixed;
    inset: 0 auto 0 0;
    z-index: 50;
    display: flex;
    width: 260px;
    flex-direction: column;
    padding: 24px 18px;
    background:
        linear-gradient(
            180deg,
            #111a31,
            #172343
        );
    color: #ffffff;
}

.app-brand {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 4px 8px 28px;
}

.app-brand-mark {
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    border-radius: 13px;
    background:
        linear-gradient(
            135deg,
            #4e73ff,
            #8658f5
        );
    font-size: 22px;
    font-weight: 900;
}

.app-brand div {
    display: flex;
    flex-direction: column;
}

.app-brand small {
    margin-top: 3px;
    color: #98a5c3;
    font-size: 11px;
}

.app-nav {
    display: grid;
    gap: 5px;
}

.app-nav a {
    display: flex;
    min-height: 46px;
    align-items: center;
    gap: 12px;
    padding: 0 14px;
    border-radius: 12px;
    color: #aeb9d2;
    font-size: 14px;
    font-weight: 700;
}

.app-nav a:hover {
    background: rgba(255, 255, 255, 0.06);
    color: #ffffff;
}

.app-nav a.active {
    background: rgba(74, 108, 255, 0.25);
    color: #ffffff;
}

.app-nav a span {
    display: grid;
    width: 24px;
    height: 24px;
    place-items: center;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.07);
    font-size: 11px;
    font-weight: 900;
}

.connect-card {
    margin-top: auto;
    padding: 18px;
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.06);
}

.connect-card strong {
    display: block;
    font-size: 13px;
}

.connect-card p {
    margin: 7px 0 14px;
    color: #aeb9d2;
    font-size: 11px;
    line-height: 1.55;
}

.connect-card button {
    width: 100%;
    min-height: 38px;
    border: 0;
    border-radius: 10px;
    background: #ffffff;
    color: #172343;
    font-weight: 800;
    cursor: pointer;
}

.app-layout {
    min-height: 100vh;
    margin-left: 260px;
}

.app-main {
    padding: 30px;
}

.app-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    margin-bottom: 26px;
}

.app-greeting {
    margin: 0 0 5px;
    color: #667085;
    font-size: 13px;
    font-weight: 700;
}

.app-topbar h1 {
    margin: 0;
    font-size: clamp(26px, 3vw, 36px);
    letter-spacing: -0.04em;
}

.app-topbar-actions {
    display: flex;
    align-items: center;
    gap: 12px;
}

.app-search {
    width: 300px;
}

.app-search input {
    width: 100%;
    height: 44px;
    padding: 0 14px;
    border: 1px solid #e2e7ef;
    border-radius: 12px;
    outline: 0;
    background: #ffffff;
    font: inherit;
}

.user-avatar {
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    border-radius: 12px;
    background:
        linear-gradient(
            135deg,
            #315efb,
            #7754e8
        );
    color: #ffffff;
    font-weight: 900;
}

.summary-grid {
    display: grid;
    grid-template-columns:
        repeat(6, minmax(0, 1fr));
    gap: 14px;
    margin-bottom: 18px;
}

.summary-card,
.dashboard-card {
    border: 1px solid #e5e9f1;
    background: #ffffff;
    box-shadow:
        0 7px 24px rgba(31, 49, 84, 0.05);
}

.summary-card {
    padding: 19px;
    border-radius: 17px;
}

.summary-card-safe {
    background:
        linear-gradient(
            135deg,
            #ecfaf4,
            #ffffff
        );
}

.summary-card span {
    color: #667085;
    font-size: 12px;
    font-weight: 700;
}

.summary-card strong {
    display: block;
    margin: 8px 0 6px;
    font-size: 23px;
    letter-spacing: -0.03em;
}

.summary-card small {
    color: #8a94a7;
    font-size: 11px;
}

.dashboard-grid {
    display: grid;
    gap: 18px;
    margin-bottom: 18px;
}

.dashboard-grid-main {
    grid-template-columns:
        minmax(250px, 0.8fr)
        minmax(430px, 1.35fr)
        minmax(280px, 0.85fr);
}

.dashboard-grid-bottom {
    grid-template-columns:
        minmax(380px, 1.25fr)
        minmax(300px, 0.9fr)
        minmax(270px, 0.8fr);
}

.dashboard-card {
    min-width: 0;
    padding: 22px;
    border-radius: 19px;
}

.card-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 18px;
}

.card-heading small {
    color: #8b95a7;
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
}

.card-heading h2 {
    margin: 4px 0 0;
    font-size: 18px;
}

.card-heading a {
    color: #315efb;
    font-size: 12px;
    font-weight: 800;
}

.account-list,
.transaction-list,
.bill-list {
    display: grid;
}

.account-row,
.transaction-row,
.bill-row {
    display: flex;
    min-height: 63px;
    align-items: center;
    border-top: 1px solid #edf0f5;
}

.account-row:first-child,
.transaction-row:first-child,
.bill-row:first-child {
    border-top: 0;
}

.account-row {
    gap: 12px;
}

.account-icon {
    display: grid;
    width: 38px;
    height: 38px;
    flex: 0 0 38px;
    place-items: center;
    border-radius: 12px;
    background: #eef3ff;
    color: #315efb;
    font-weight: 900;
}

.account-copy,
.transaction-copy {
    display: flex;
    min-width: 0;
    flex: 1;
    flex-direction: column;
}

.account-copy strong,
.transaction-copy strong,
.bill-row strong {
    font-size: 13px;
}

.account-copy small,
.transaction-copy small,
.bill-row small {
    margin-top: 3px;
    color: #8b95a7;
    font-size: 11px;
}

.transaction-row {
    gap: 12px;
}

.transaction-date {
    width: 48px;
    flex: 0 0 48px;
    color: #8994a8;
    font-size: 11px;
    font-weight: 800;
}

.bill-row {
    justify-content: space-between;
    gap: 16px;
}

.bill-row > div:first-child {
    display: flex;
    flex-direction: column;
}

.bill-meta {
    display: flex;
    align-items: flex-end;
    flex-direction: column;
    gap: 5px;
}

.bill-meta span {
    padding: 4px 7px;
    border-radius: 999px;
    background: #eef1f6;
    color: #667085;
    font-size: 9px;
    font-weight: 800;
}

.spending-list {
    display: grid;
    gap: 16px;
}

.spending-row-head {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 7px;
    font-size: 12px;
}

.spending-track {
    overflow: hidden;
    height: 8px;
    border-radius: 999px;
    background: #edf1f7;
}

.spending-track span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background:
        linear-gradient(
            90deg,
            #315efb,
            #7654e8
        );
}

.spending-row small {
    display: block;
    margin-top: 5px;
    color: #98a2b3;
    font-size: 10px;
}

.habit-grid {
    display: grid;
    grid-template-columns:
        repeat(2, minmax(0, 1fr));
    gap: 12px;
}

.habit-grid div {
    padding: 16px;
    border: 1px solid #e7ebf2;
    border-radius: 15px;
    background: #fafbfe;
}

.habit-grid span,
.habit-grid small {
    display: block;
    color: #7c879a;
}

.habit-grid strong {
    display: block;
    margin: 5px 0;
    font-size: 21px;
}

.insight-box {
    margin-top: 14px;
    padding: 15px;
    border-radius: 14px;
    background: #eef5ff;
}

.insight-box strong {
    font-size: 12px;
}

.insight-box p {
    margin: 5px 0 0;
    color: #617089;
    font-size: 11px;
    line-height: 1.55;
}

.money-flow {
    display: grid;
    gap: 8px;
}

.money-flow > div {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding: 13px 14px;
    border-radius: 12px;
    background: #f7f9fc;
    font-size: 12px;
}

.money-flow-highlight {
    background: #eaf8f1 !important;
}

.money-flow-highlight strong {
    color: #16875f;
}

@media (max-width: 1350px) {
    .summary-grid {
        grid-template-columns:
            repeat(3, minmax(0, 1fr));
    }

    .dashboard-grid-main,
    .dashboard-grid-bottom {
        grid-template-columns:
            repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 900px) {
    .app-sidebar {
        position: static;
        width: 100%;
    }

    .connect-card {
        display: none;
    }

    .app-nav {
        display: flex;
        overflow-x: auto;
    }

    .app-nav a {
        flex: 0 0 auto;
    }

    .app-layout {
        margin-left: 0;
    }

    .app-main {
        padding: 20px;
    }

    .app-topbar {
        align-items: flex-start;
        flex-direction: column;
    }

    .app-topbar-actions,
    .app-search {
        width: 100%;
    }

    .summary-grid,
    .dashboard-grid-main,
    .dashboard-grid-bottom {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 560px) {
    .summary-grid {
        grid-template-columns:
            repeat(2, minmax(0, 1fr));
    }

    .habit-grid {
        grid-template-columns: 1fr;
    }
}
.accounts-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    margin-bottom: 26px;
}

.accounts-header h1 {
    margin: 0;
    font-size: 36px;
    letter-spacing: -0.04em;
}

.accounts-subtitle {
    margin: 7px 0 0;
    color: #667085;
    font-size: 14px;
}

.accounts-actions {
    display: flex;
    gap: 10px;
}

.primary-button,
.secondary-button {
    min-height: 44px;
    padding: 0 17px;
    border-radius: 12px;
    font: inherit;
    font-size: 13px;
    font-weight: 800;
    cursor: pointer;
}

.primary-button {
    border: 0;
    background: #315efb;
    color: #ffffff;
}

.secondary-button {
    border: 1px solid #dfe5ee;
    background: #ffffff;
    color: #273249;
}

.account-summary-grid {
    display: grid;
    grid-template-columns:
        repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin-bottom: 18px;
}

.account-summary-grid article {
    padding: 22px;
    border: 1px solid #e5e9f1;
    border-radius: 18px;
    background: #ffffff;
    box-shadow:
        0 7px 24px rgba(31, 49, 84, 0.05);
}

.account-summary-grid span {
    color: #667085;
    font-size: 12px;
    font-weight: 700;
}

.account-summary-grid strong {
    display: block;
    margin: 8px 0 5px;
    font-size: 26px;
}

.account-summary-grid small {
    color: #98a2b3;
    font-size: 11px;
}

.accounts-card {
    padding: 24px;
    border: 1px solid #e5e9f1;
    border-radius: 20px;
    background: #ffffff;
    box-shadow:
        0 7px 24px rgba(31, 49, 84, 0.05);
}

.accounts-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 20px;
}

.accounts-card-header small {
    color: #8b95a7;
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
}

.accounts-card-header h2 {
    margin: 5px 0 0;
    font-size: 22px;
}

.account-filters {
    display: flex;
    gap: 7px;
}

.account-filters button {
    min-height: 35px;
    padding: 0 13px;
    border: 1px solid #e1e6ef;
    border-radius: 10px;
    background: #ffffff;
    color: #697386;
    font-size: 11px;
    font-weight: 800;
    cursor: pointer;
}

.account-filters button.active {
    border-color: #315efb;
    background: #eef3ff;
    color: #315efb;
}

.accounts-table {
    overflow: hidden;
    border: 1px solid #e7ebf2;
    border-radius: 15px;
}

.accounts-table-head,
.accounts-table-row {
    display: grid;
    grid-template-columns:
        minmax(260px, 1.6fr)
        minmax(100px, 0.7fr)
        minmax(120px, 0.7fr)
        minmax(130px, 0.7fr)
        minmax(140px, 0.8fr);
    align-items: center;
    gap: 18px;
}

.accounts-table-head {
    min-height: 42px;
    padding: 0 18px;
    background: #f7f9fc;
    color: #7c8799;
    font-size: 10px;
    font-weight: 800;
    text-transform: uppercase;
}

.accounts-table-row {
    min-height: 76px;
    padding: 12px 18px;
    border-top: 1px solid #edf0f5;
}

.account-name-cell {
    display: flex;
    align-items: center;
    gap: 13px;
    min-width: 0;
}

.account-logo {
    display: grid;
    width: 42px;
    height: 42px;
    flex: 0 0 42px;
    place-items: center;
    border-radius: 12px;
    background: #eef3ff;
    color: #315efb;
    font-weight: 900;
}

.account-name-cell > div {
    display: flex;
    min-width: 0;
    flex-direction: column;
}

.account-name-cell strong {
    font-size: 13px;
}

.account-name-cell small {
    margin-top: 4px;
    color: #8c97aa;
    font-size: 10px;
}

.source-badge {
    display: inline-flex;
    padding: 5px 8px;
    border-radius: 999px;
    background: #eef3ff;
    color: #315efb;
    font-size: 9px;
    font-weight: 800;
}

.account-type-cell strong {
    font-size: 13px;
}

.account-money-cell {
    text-align: right;
    font-size: 13px;
}

.account-money-cell strong {
    font-size: 14px;
}

@media (max-width: 1050px) {
    .account-summary-grid {
        grid-template-columns: 1fr;
    }

    .accounts-table {
        overflow-x: auto;
    }

    .accounts-table-head,
    .accounts-table-row {
        min-width: 900px;
    }
}

@media (max-width: 700px) {
    .accounts-header,
    .accounts-card-header {
        align-items: flex-start;
        flex-direction: column;
    }

    .accounts-actions {
        width: 100%;
    }

    .primary-button,
    .secondary-button {
        flex: 1;
    }

    .account-filters {
        overflow-x: auto;
        width: 100%;
    }
}
.transactions-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    margin-bottom: 26px;
}

.transactions-header h1 {
    margin: 0;
    font-size: 36px;
    letter-spacing: -0.04em;
}

.transactions-subtitle {
    margin: 7px 0 0;
    color: #667085;
    font-size: 14px;
}

.transactions-actions {
    display: flex;
    gap: 10px;
}

.transaction-summary-grid {
    display: grid;
    grid-template-columns:
        repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin-bottom: 18px;
}

.transaction-summary-grid article {
    padding: 22px;
    border: 1px solid #e5e9f1;
    border-radius: 18px;
    background: #ffffff;
    box-shadow:
        0 7px 24px rgba(31, 49, 84, 0.05);
}

.transaction-summary-grid span {
    color: #667085;
    font-size: 12px;
    font-weight: 700;
}

.transaction-summary-grid strong {
    display: block;
    margin: 8px 0 5px;
    font-size: 26px;
}

.transaction-summary-grid small {
    color: #98a2b3;
    font-size: 11px;
}

.transactions-card {
    padding: 24px;
    border: 1px solid #e5e9f1;
    border-radius: 20px;
    background: #ffffff;
    box-shadow:
        0 7px 24px rgba(31, 49, 84, 0.05);
}

.transactions-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 20px;
}

.transactions-search {
    width: min(360px, 100%);
}

.transactions-search input {
    width: 100%;
    height: 42px;
    padding: 0 14px;
    border: 1px solid #dfe5ee;
    border-radius: 11px;
    outline: 0;
    background: #ffffff;
    font: inherit;
}

.transactions-filters {
    display: flex;
    gap: 7px;
    overflow-x: auto;
}

.transactions-filters button {
    min-height: 35px;
    padding: 0 13px;
    border: 1px solid #e1e6ef;
    border-radius: 10px;
    background: #ffffff;
    color: #697386;
    font-size: 11px;
    font-weight: 800;
    white-space: nowrap;
    cursor: pointer;
}

.transactions-filters button.active {
    border-color: #315efb;
    background: #eef3ff;
    color: #315efb;
}

.transactions-table {
    overflow: hidden;
    border: 1px solid #e7ebf2;
    border-radius: 15px;
}

.transactions-table-head,
.transactions-table-row {
    display: grid;
    grid-template-columns:
        90px
        minmax(230px, 1.4fr)
        minmax(170px, 1fr)
        minmax(180px, 1fr)
        100px
        120px;
    align-items: center;
    gap: 18px;
}

.transactions-table-head {
    min-height: 42px;
    padding: 0 18px;
    background: #f7f9fc;
    color: #7c8799;
    font-size: 10px;
    font-weight: 800;
    text-transform: uppercase;
}

.transactions-table-row {
    min-height: 72px;
    padding: 12px 18px;
    border-top: 1px solid #edf0f5;
    color: #475467;
    font-size: 12px;
}

.transaction-date-cell {
    color: #8490a4;
    font-size: 11px;
    font-weight: 800;
}

.transaction-name-cell {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
}

.transaction-icon {
    display: grid;
    width: 38px;
    height: 38px;
    flex: 0 0 38px;
    place-items: center;
    border-radius: 11px;
    background: #eef3ff;
    color: #315efb;
    font-weight: 900;
}

.transaction-name-cell > div {
    display: flex;
    min-width: 0;
    flex-direction: column;
}

.transaction-name-cell strong {
    overflow: hidden;
    color: #172033;
    font-size: 13px;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.transaction-name-cell small {
    margin-top: 3px;
    color: #98a2b3;
    font-size: 10px;
}

.status-badge {
    display: inline-flex;
    padding: 5px 8px;
    border-radius: 999px;
    background: #eef1f6;
    color: #667085;
    font-size: 9px;
    font-weight: 800;
}

.transaction-amount-cell {
    text-align: right;
    font-weight: 900;
}

@media (max-width: 1100px) {
    .transaction-summary-grid {
        grid-template-columns:
            repeat(2, minmax(0, 1fr));
    }

    .transactions-toolbar {
        align-items: stretch;
        flex-direction: column;
    }

    .transactions-search {
        width: 100%;
    }

    .transactions-table {
        overflow-x: auto;
    }

    .transactions-table-head,
    .transactions-table-row {
        min-width: 1050px;
    }
}

@media (max-width: 700px) {
    .transactions-header {
        align-items: flex-start;
        flex-direction: column;
    }

    .transactions-actions {
        width: 100%;
    }

    .transactions-actions button {
        flex: 1;
    }

    .transaction-summary-grid {
        grid-template-columns: 1fr;
    }
}
.bills-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    margin-bottom: 26px;
}

.bills-header h1 {
    margin: 0;
    font-size: 36px;
    letter-spacing: -0.04em;
}

.bills-subtitle {
    margin: 7px 0 0;
    color: #667085;
    font-size: 14px;
}

.bills-actions {
    display: flex;
    gap: 10px;
}

.bill-summary-grid {
    display: grid;
    grid-template-columns:
        repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin-bottom: 18px;
}

.bill-summary-grid article {
    padding: 22px;
    border: 1px solid #e5e9f1;
    border-radius: 18px;
    background: #ffffff;
    box-shadow:
        0 7px 24px rgba(31, 49, 84, 0.05);
}

.bill-summary-grid span {
    color: #667085;
    font-size: 12px;
    font-weight: 700;
}

.bill-summary-grid strong {
    display: block;
    margin: 8px 0 5px;
    font-size: 26px;
}

.bill-summary-grid small {
    color: #98a2b3;
    font-size: 11px;
}

.bills-layout {
    display: grid;
    grid-template-columns:
        minmax(0, 1fr)
        300px;
    gap: 18px;
}

.bills-card,
.bill-side-card {
    border: 1px solid #e5e9f1;
    border-radius: 20px;
    background: #ffffff;
    box-shadow:
        0 7px 24px rgba(31, 49, 84, 0.05);
}

.bills-card {
    padding: 24px;
}

.bill-side-card {
    padding: 22px;
}

.bills-card-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 20px;
}

.bills-card-heading small,
.bill-side-card > small {
    color: #8b95a7;
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
}

.bills-card-heading h2,
.bill-side-card h2 {
    margin: 5px 0 0;
    font-size: 22px;
}

.bill-filters {
    display: flex;
    gap: 7px;
    overflow-x: auto;
}

.bill-filters button {
    min-height: 35px;
    padding: 0 13px;
    border: 1px solid #e1e6ef;
    border-radius: 10px;
    background: #ffffff;
    color: #697386;
    font-size: 11px;
    font-weight: 800;
    white-space: nowrap;
    cursor: pointer;
}

.bill-filters button.active {
    border-color: #315efb;
    background: #eef3ff;
    color: #315efb;
}

.bills-table {
    overflow: hidden;
    border: 1px solid #e7ebf2;
    border-radius: 15px;
}

.bills-table-head,
.bills-table-row {
    display: grid;
    grid-template-columns:
        minmax(190px, 1.25fr)
        90px
        100px
        minmax(150px, 1fr)
        80px
        110px
        100px;
    align-items: center;
    gap: 16px;
}

.bills-table-head {
    min-height: 42px;
    padding: 0 18px;
    background: #f7f9fc;
    color: #7c8799;
    font-size: 10px;
    font-weight: 800;
    text-transform: uppercase;
}

.bills-table-row {
    min-height: 74px;
    padding: 12px 18px;
    border-top: 1px solid #edf0f5;
    color: #475467;
    font-size: 12px;
}

.bill-name-cell {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
}

.bill-icon {
    display: grid;
    width: 38px;
    height: 38px;
    flex: 0 0 38px;
    place-items: center;
    border-radius: 11px;
    background: #eef3ff;
    color: #315efb;
    font-weight: 900;
}

.bill-name-cell > div {
    display: flex;
    min-width: 0;
    flex-direction: column;
}

.bill-name-cell strong {
    color: #172033;
    font-size: 13px;
}

.bill-name-cell small {
    margin-top: 3px;
    color: #98a2b3;
    font-size: 10px;
}

.autopay-badge,
.bill-status-badge {
    display: inline-flex;
    padding: 5px 8px;
    border-radius: 999px;
    font-size: 9px;
    font-weight: 800;
}

.autopay-badge.on {
    background: #e8f8f1;
    color: #16875f;
}

.autopay-badge.off {
    background: #eef1f6;
    color: #667085;
}

.bill-status-badge {
    background: #eef1f6;
    color: #667085;
}

.bill-status-badge.paid {
    background: #e8f8f1;
    color: #16875f;
}

.bill-status-badge.due-soon {
    background: #fff0ee;
    color: #c44b4e;
}

.bill-amount-cell {
    text-align: right;
}

.bill-health-list {
    display: grid;
    gap: 10px;
    margin-top: 22px;
}

.bill-health-list div {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding: 13px;
    border-radius: 12px;
    background: #f7f9fc;
    font-size: 12px;
}

.bill-note {
    margin-top: 16px;
    padding: 16px;
    border-radius: 14px;
    background: #eef5ff;
}

.bill-note strong {
    font-size: 12px;
}

.bill-note p {
    margin: 6px 0 0;
    color: #617089;
    font-size: 11px;
    line-height: 1.55;
}

@media (max-width: 1200px) {
    .bills-layout {
        grid-template-columns: 1fr;
    }

    .bill-side-card {
        width: 100%;
    }
}

@media (max-width: 1050px) {
    .bill-summary-grid {
        grid-template-columns:
            repeat(2, minmax(0, 1fr));
    }

    .bills-table {
        overflow-x: auto;
    }

    .bills-table-head,
    .bills-table-row {
        min-width: 1000px;
    }
}

@media (max-width: 700px) {
    .bills-header,
    .bills-card-heading {
        align-items: flex-start;
        flex-direction: column;
    }

    .bills-actions {
        width: 100%;
    }

    .bills-actions button {
        flex: 1;
    }

    .bill-summary-grid {
        grid-template-columns: 1fr;
    }
}
.budgets-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    margin-bottom: 26px;
}

.budgets-header h1 {
    margin: 0;
    font-size: 36px;
    letter-spacing: -0.04em;
}

.budgets-subtitle {
    margin: 7px 0 0;
    color: #667085;
    font-size: 14px;
}

.budgets-actions {
    display: flex;
    gap: 10px;
}

.budget-summary-grid {
    display: grid;
    grid-template-columns:
        repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin-bottom: 18px;
}

.budget-summary-grid article {
    padding: 22px;
    border: 1px solid #e5e9f1;
    border-radius: 18px;
    background: #ffffff;
    box-shadow:
        0 7px 24px rgba(31, 49, 84, 0.05);
}

.budget-summary-grid span {
    color: #667085;
    font-size: 12px;
    font-weight: 700;
}

.budget-summary-grid strong {
    display: block;
    margin: 8px 0 5px;
    font-size: 26px;
}

.budget-summary-grid small {
    color: #98a2b3;
    font-size: 11px;
}

.budgets-layout {
    display: grid;
    grid-template-columns:
        minmax(0, 1fr)
        310px;
    gap: 18px;
}

.budgets-card,
.budget-side-card {
    border: 1px solid #e5e9f1;
    border-radius: 20px;
    background: #ffffff;
    box-shadow:
        0 7px 24px rgba(31, 49, 84, 0.05);
}

.budgets-card {
    padding: 24px;
}

.budget-side-card {
    padding: 22px;
}

.budgets-card-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 20px;
}

.budgets-card-heading small,
.budget-side-card > small {
    color: #8b95a7;
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
}

.budgets-card-heading h2,
.budget-side-card h2 {
    margin: 5px 0 0;
    font-size: 22px;
}

.budget-month {
    padding: 8px 11px;
    border-radius: 10px;
    background: #f4f6fb;
    color: #667085;
    font-size: 11px;
    font-weight: 800;
}

.budget-list {
    display: grid;
    gap: 14px;
}

.budget-row {
    padding: 18px;
    border: 1px solid #e7ebf2;
    border-radius: 15px;
    background: #ffffff;
}

.budget-row-top {
    display: flex;
    justify-content: space-between;
    gap: 20px;
}

.budget-row-top > div:first-child,
.budget-remaining {
    display: flex;
    flex-direction: column;
}

.budget-row-top strong {
    font-size: 14px;
}

.budget-row-top small {
    margin-top: 4px;
    color: #8b95a7;
    font-size: 10px;
}

.budget-remaining {
    align-items: flex-end;
}

.budget-remaining span {
    color: #98a2b3;
    font-size: 9px;
    text-transform: uppercase;
}

.budget-remaining strong {
    margin-top: 3px;
}

.budget-progress {
    overflow: hidden;
    height: 9px;
    margin-top: 14px;
    border-radius: 999px;
    background: #edf1f7;
}

.budget-progress span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background:
        linear-gradient(
            90deg,
            #315efb,
            #7654e8
        );
}

.budget-progress span.near-limit {
    background:
        linear-gradient(
            90deg,
            #f0a03b,
            #d15a61
        );
}

.budget-row-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 8px;
}

.budget-row-bottom small {
    color: #98a2b3;
    font-size: 10px;
}

.budget-row-bottom button {
    border: 0;
    background: transparent;
    color: #315efb;
    font-size: 10px;
    font-weight: 800;
    cursor: pointer;
}

.budget-side-stat {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-top: 10px;
    padding: 14px;
    border-radius: 12px;
    background: #f7f9fc;
    font-size: 12px;
}

.budget-side-highlight {
    background: #eaf8f1;
}

.budget-side-highlight strong {
    color: #16875f;
}

.budget-note {
    margin-top: 16px;
    padding: 16px;
    border-radius: 14px;
    background: #eef5ff;
}

.budget-note strong {
    font-size: 12px;
}

.budget-note p {
    margin: 6px 0 0;
    color: #617089;
    font-size: 11px;
    line-height: 1.55;
}

@media (max-width: 1100px) {
    .budgets-layout {
        grid-template-columns: 1fr;
    }

    .budget-summary-grid {
        grid-template-columns:
            repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 700px) {
    .budgets-header,
    .budgets-card-heading {
        align-items: flex-start;
        flex-direction: column;
    }

    .budgets-actions {
        width: 100%;
    }

    .budgets-actions button {
        flex: 1;
    }

    .budget-summary-grid {
        grid-template-columns: 1fr;
    }

    .budget-row-top {
        flex-direction: column;
    }

    .budget-remaining {
        align-items: flex-start;
    }
}
