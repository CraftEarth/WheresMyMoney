    font-weight: 800;
}

.crypto-value-cell {
    text-align: right;
}

.crypto-allocation-list {
    display: grid;
    gap: 16px;
    margin-top: 22px;
}

.crypto-allocation-row > div:first-child {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 6px;
    font-size: 12px;
}

.crypto-allocation-track {
    overflow: hidden;
    height: 8px;
    border-radius: 999px;
    background: #edf1f7;
}

.crypto-allocation-track span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background:
        linear-gradient(
            90deg,
            #315efb,
            #7654e8
        );
}

.crypto-note {
    margin-top: 20px;
    padding: 16px;
    border-radius: 14px;
    background: #eef5ff;
}

.crypto-note strong {
    font-size: 12px;
}

.crypto-note p {
    margin: 6px 0 0;
    color: #617089;
    font-size: 11px;
    line-height: 1.55;
}

