.reports-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    margin-bottom: 26px;
}

.reports-header h1 {
    margin: 0;
    font-size: 36px;
    letter-spacing: -0.04em;
}

.reports-subtitle {
    margin: 7px 0 0;
    color: #667085;
    font-size: 14px;
}

.reports-actions {
    display: flex;
    gap: 10px;
}

.report-summary-grid {
    display: grid;
    grid-template-columns:
        repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin-bottom: 18px;
}

.report-summary-grid article {
    padding: 22px;
    border: 1px solid #e5e9f1;
    border-radius: 18px;
    background: #ffffff;
    box-shadow:
        0 7px 24px rgba(31, 49, 84, 0.05);
}

.report-summary-grid span {
    color: #667085;
    font-size: 12px;
    font-weight: 700;
}

.report-summary-grid strong {
    display: block;
    margin: 8px 0 5px;
    font-size: 26px;
}

.report-summary-grid small {
    color: #98a2b3;
    font-size: 11px;
}

.reports-grid {
    display: grid;
    grid-template-columns:
        repeat(2, minmax(0, 1fr));
    gap: 18px;
}

.reports-card {
    padding: 24px;
    border: 1px solid #e5e9f1;
    border-radius: 20px;
    background: #ffffff;
    box-shadow:
        0 7px 24px rgba(31, 49, 84, 0.05);
}

.report-wide {
    grid-column: span 2;
}

.reports-card-heading {
    margin-bottom: 20px;
}

.reports-card-heading small {
    color: #8b95a7;
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
}

.reports-card-heading h2 {
    margin: 5px 0 0;
    font-size: 22px;
}

.report-history {
    display: grid;
}

.report-history-row {
    display: grid;
    grid-template-columns:
        minmax(170px, 1.4fr)
        repeat(3, minmax(110px, 0.8fr));
    align-items: center;
    gap: 18px;
    min-height: 72px;
    border-top: 1px solid #edf0f5;
}

.report-history-row:first-child {
    border-top: 0;
}

.report-history-row > div {
    display: flex;
    flex-direction: column;
}

.report-history-row strong {
    font-size: 13px;
}

.report-history-row span,
.report-history-row small {
    color: #98a2b3;
    font-size: 10px;
}

.report-category-list {
    display: grid;
    gap: 17px;
}

.report-category-top {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 7px;
    font-size: 12px;
}

.report-category-track {
    overflow: hidden;
    height: 8px;
    border-radius: 999px;
    background: #edf1f7;
}

.report-category-track span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background:
        linear-gradient(
            90deg,
            #315efb,
            #7654e8
        );
}

.report-category-row small {
    display: block;
    margin-top: 5px;
    color: #98a2b3;
    font-size: 10px;
}

.report-insight-grid {
    display: grid;
    grid-template-columns:
        repeat(4, minmax(0, 1fr));
    gap: 14px;
}

.report-insight-grid > div {
    padding: 18px;
    border: 1px solid #e7ebf2;
    border-radius: 15px;
    background: #fafbfe;
}

.report-insight-grid span {
    display: block;
    color: #7c879a;
    font-size: 10px;
    font-weight: 800;
    text-transform: uppercase;
}

.report-insight-grid strong {
    display: block;
    margin: 8px 0 4px;
    font-size: 20px;
}

.report-insight-grid small {
    color: #98a2b3;
    font-size: 10px;
}

@media (max-width: 1000px) {
    .report-summary-grid {
        grid-template-columns:
            repeat(2, minmax(0, 1fr));
    }

    .reports-grid {
        grid-template-columns: 1fr;
    }

    .report-wide {
        grid-column: auto;
    }

    .report-insight-grid {
        grid-template-columns:
            repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 700px) {
    .reports-header {
        align-items: flex-start;
        flex-direction: column;
    }

    .reports-actions {
        width: 100%;
    }

    .reports-actions button {
        flex: 1;
    }

    .report-summary-grid,
    .report-insight-grid {
        grid-template-columns: 1fr;
    }

    .report-history {
        overflow-x: auto;
    }

    .report-history-row {
        min-width: 650px;
    }
}
.settings-header {
    margin-bottom: 26px;
}

.settings-header h1 {
    margin: 0;
    font-size: 36px;
    letter-spacing: -0.04em;
}

.settings-subtitle {
    margin: 7px 0 0;
    color: #667085;
    font-size: 14px;
}

.settings-layout {
    display: grid;
    grid-template-columns:
        minmax(0, 1fr)
        340px;
    align-items: start;
    gap: 18px;
}

.settings-main,
.settings-side {
    display: grid;
    gap: 18px;
}

.settings-card {
    padding: 24px;
    border: 1px solid #e5e9f1;
    border-radius: 20px;
    background: #ffffff;
    box-shadow:
        0 7px 24px rgba(31, 49, 84, 0.05);
}

.settings-card-heading {
    margin-bottom: 20px;
}

.settings-card-heading small {
    color: #8b95a7;
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
}

.settings-card-heading h2 {
    margin: 5px 0 0;
    font-size: 22px;
}

.settings-form-grid {
    display: grid;
    grid-template-columns:
        repeat(2, minmax(0, 1fr));
    gap: 18px;
}

.settings-form-grid label {
    display: flex;
    flex-direction: column;
    gap: 7px;
}

.settings-form-grid label > span {
    color: #667085;
    font-size: 11px;
    font-weight: 800;
}

.settings-form-grid input,
.settings-form-grid select {
    width: 100%;
    height: 43px;
    padding: 0 12px;
    border: 1px solid #dfe5ee;
    border-radius: 11px;
    outline: 0;
    background: #ffffff;
    color: #172033;
    font: inherit;
}

.settings-toggle-list {
    display: grid;
}

.settings-toggle-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 74px;
    border-top: 1px solid #edf0f5;
}

.settings-toggle-row:first-child {
    border-top: 0;
}

.settings-toggle-row > div {
    display: flex;
    flex-direction: column;
}

.settings-toggle-row strong {
    font-size: 13px;
}

.settings-toggle-row small {
    max-width: 520px;
    margin-top: 4px;
    color: #8c97aa;
    font-size: 10px;
    line-height: 1.5;
}

.settings-toggle-row input[type="checkbox"] {
    width: 19px;
    height: 19px;
    accent-color: #315efb;
}

.settings-action-list {
    display: grid;
}

.settings-action-list > div {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    min-height: 78px;
    border-top: 1px solid #edf0f5;
}

.settings-action-list > div:first-child {
    border-top: 0;
}

.settings-action-list > div > div {
    display: flex;
    flex-direction: column;
}

.settings-action-list strong {
    font-size: 13px;
}

.settings-action-list small {
    max-width: 580px;
    margin-top: 4px;
    color: #8c97aa;
    font-size: 10px;
    line-height: 1.5;
}

.settings-info-list {
    display: grid;
    gap: 12px;
}

.settings-info-list > div {
    padding: 15px;
    border-radius: 13px;
    background: #f7f9fc;
}

.settings-info-list strong {
    font-size: 12px;
}

.settings-info-list p {
    margin: 6px 0 0;
    color: #667085;
    font-size: 10px;
    line-height: 1.55;
}

.settings-save-button {
    width: 100%;
    min-height: 48px;
    border: 0;
    border-radius: 13px;
    background: #315efb;
    color: #ffffff;
    font: inherit;
    font-size: 13px;
    font-weight: 900;
    cursor: pointer;
    box-shadow:
        0 10px 24px rgba(49, 94, 251, 0.20);
}

@media (max-width: 1000px) {
    .settings-layout {
        grid-template-columns: 1fr;
    }

    .settings-side {
        grid-template-columns:
            repeat(2, minmax(0, 1fr));
    }

    .settings-save-button {
        grid-column: span 2;
    }
}

@media (max-width: 700px) {
    .settings-form-grid,
    .settings-side {
        grid-template-columns: 1fr;
    }

    .settings-save-button {
        grid-column: auto;
    }

    .settings-action-list > div,
    .settings-toggle-row {
        align-items: flex-start;
        flex-direction: column;
        padding: 16px 0;
    }
}
.settings-message {
    margin-bottom: 18px;
    padding: 13px 16px;
    border-radius: 12px;
    font-size: 12px;
    font-weight: 800;
}

.success-message {
    background: #e8f8f1;
    color: #16875f;
}

.error-message {
    background: #fff0f1;
    color: #a73340;
}

.settings-logout {
    display: flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    border: 1px solid #e1e6ef;
    border-radius: 11px;
    color: #c74452;
    font-size: 12px;
    font-weight: 900;
}
.account-summary-grid {
    grid-template-columns:
        repeat(4, minmax(0, 1fr));
}

.accounts-empty {
    padding: 60px 20px;
    text-align: center;
}

.accounts-empty strong {
    display: block;
    font-size: 18px;
}

.accounts-empty p {
    margin: 8px 0 20px;
    color: #7c8798;
    font-size: 13px;
}

.account-actions-cell {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 10px;
}

.account-actions-cell a,
.account-actions-cell button {
    border: 0;
    background: transparent;
    color: #315efb;
    font: inherit;
    font-size: 11px;
    font-weight: 800;
    cursor: pointer;
}

.account-actions-cell form {
    margin: 0;
}

.account-actions-cell button {
    color: #c74452;
}

.account-form-card {
    padding: 26px;
    border: 1px solid #e5e9f1;
    border-radius: 20px;
    background: #ffffff;
    box-shadow:
        0 7px 24px rgba(31, 49, 84, 0.05);
}

.account-form {
    display: grid;
    gap: 24px;
}

.account-form-grid {
    display: grid;
    grid-template-columns:
        repeat(2, minmax(0, 1fr));
    gap: 18px;
}

.account-form-grid label {
    display: grid;
    gap: 7px;
}

.account-form-grid label span {
    color: #667085;
    font-size: 11px;
    font-weight: 800;
}

.account-form-grid input,
.account-form-grid select {
    width: 100%;
    height: 44px;
    padding: 0 12px;
    border: 1px solid #dfe5ee;
    border-radius: 11px;
    outline: 0;
    background: #ffffff;
    color: #172033;
    font: inherit;
}

.account-form-grid input:focus,
.account-form-grid select:focus {
    border-color: #315efb;
}

.account-toggle-list {
    display: grid;
    border-top: 1px solid #edf0f5;
}

.account-form-actions {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
}

.account-form-actions .primary-button,
.account-form-actions .secondary-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
}

@media (max-width: 900px) {
    .account-summary-grid {
        grid-template-columns:
            repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 700px) {
    .account-summary-grid,
    .account-form-grid {
        grid-template-columns: 1fr;
    }

    .account-form-actions {
        flex-direction: column;
    }
}
.transactions-table-head,
.transactions-table-row {
    grid-template-columns:
        85px
        minmax(210px, 1.4fr)
        minmax(130px, 0.9fr)
        minmax(150px, 1fr)
        90px
        110px
        100px;
}

.transaction-actions-cell {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
}

.transaction-actions-cell form {
    margin: 0;
}

.transaction-actions-cell a,
.transaction-actions-cell button {
    border: 0;
    background: transparent;
    color: #315efb;
    font: inherit;
    font-size: 10px;
    font-weight: 900;
    cursor: pointer;
}

.transaction-actions-cell button {
    color: #c74452;
}

.transaction-notes-field {
    display: grid;
    gap: 7px;
}

.transaction-notes-field > span {
    color: #667085;
    font-size: 11px;
    font-weight: 800;
}

.transaction-notes-field textarea {
    width: 100%;
    padding: 12px;
    border: 1px solid #dfe5ee;
    border-radius: 11px;
    outline: 0;
    resize: vertical;
    font: inherit;
}

.transaction-notes-field textarea:focus {
    border-color: #315efb;
}

.transactions-actions .primary-button,
.accounts-actions .secondary-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
}
.dashboard-empty {
    padding: 24px 10px;
    color: #8b95a7;
    font-size: 12px;
    text-align: center;
}
.bills-table-head,
.bills-table-row {
    grid-template-columns:
        minmax(190px, 1.25fr)
        90px
        100px
        minmax(140px, 1fr)
        75px
        100px
        100px
        95px;
}

.bill-actions-cell {
    display: flex;
    justify-content: flex-end;
    gap: 9px;
}

.bill-actions-cell form {
    margin: 0;
}

.bill-actions-cell a,
.bill-actions-cell button {
    border: 0;
    background: transparent;
    color: #315efb;
    font: inherit;
    font-size: 10px;
    font-weight: 900;
    cursor: pointer;
}

.bill-actions-cell button {
    color: #c74452;
}

.bill-status-badge.overdue {
    background: #fff0f1;
    color: #c74452;
}

.bill-status-badge.upcoming {
    background: #eef3ff;
    color: #315efb;
}
.budget-actions {
    display: flex;
    align-items: center;
    gap: 10px;
}

.budget-actions form {
    margin: 0;
}

.budget-actions a,
.budget-actions button {
    border: 0;
    background: transparent;
    color: #315efb;
    font: inherit;
    font-size: 10px;
    font-weight: 900;
    cursor: pointer;
}

.budget-actions button {
    color: #c74452;
}

.budgets-actions .primary-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
}
.crypto-table-head,
.crypto-table-row {
    grid-template-columns:
        minmax(180px, 1.3fr)
        105px
        110px
        120px
        120px
        120px
        95px;
}

.crypto-actions-cell {
    display: flex;
    justify-content: flex-end;
    gap: 9px;
}

.crypto-actions-cell form {
    margin: 0;
}

.crypto-actions-cell a,
.crypto-actions-cell button {
    border: 0;
    background: transparent;
    color: #315efb;
    font: inherit;
    font-size: 10px;
    font-weight: 900;
    cursor: pointer;
}

.crypto-actions-cell button {
    color: #c74452;
}

.crypto-actions .primary-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
}
.import-card {
    margin-bottom: 18px;
    padding: 24px;
    border: 1px solid #e5e9f1;
    border-radius: 20px;
    background: #ffffff;
    box-shadow:
        0 7px 24px rgba(31, 49, 84, 0.05);
}

.import-heading {
    margin-bottom: 20px;
}

.import-heading small {
    color: #8b95a7;
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
}

.import-heading h2 {
    margin: 5px 0 0;
    font-size: 22px;
}

.import-heading p {
    margin: 7px 0 0;
    color: #667085;
    font-size: 12px;
}

.import-upload-form,
.import-map-grid {
    display: grid;
    gap: 18px;
}

.import-upload-form {
    grid-template-columns:
        minmax(220px, 1fr)
        minmax(260px, 1fr)
        auto;
    align-items: end;
}

.import-map-grid {
    grid-template-columns:
        repeat(3, minmax(0, 1fr));
}

.import-upload-form label,
.import-map-grid label {
    display: grid;
    gap: 7px;
}

.import-upload-form label > span,
.import-map-grid label > span {
    color: #667085;
    font-size: 11px;
    font-weight: 800;
}

.import-upload-form input,
.import-upload-form select,
.import-map-grid select {
    width: 100%;
    min-height: 44px;
    padding: 0 12px;
    border: 1px solid #dfe5ee;
    border-radius: 11px;
    background: #ffffff;
    color: #172033;
    font: inherit;
}

.import-upload-form input[type="file"] {
    padding: 9px 12px;
}

.import-preview-table {
    overflow-x: auto;
    margin-top: 24px;
    border: 1px solid #e7ebf2;
    border-radius: 14px;
}

.import-preview-head,
.import-preview-row {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(160px, 1fr);
    min-width: max-content;
}

.import-preview-head {
    background: #f7f9fc;
    color: #7c8799;
    font-size: 10px;
    font-weight: 800;
    text-transform: uppercase;
}

.import-preview-head span,
.import-preview-row span {
    min-width: 160px;
    padding: 12px 14px;
    border-right: 1px solid #edf0f5;
}

.import-preview-row {
    border-top: 1px solid #edf0f5;
    color: #475467;
    font-size: 11px;
}

.import-warning {
    margin-top: 20px;
    padding: 16px;
    border-radius: 14px;
    background: #eef5ff;
}

.import-warning strong {
    font-size: 12px;
}

.import-warning p {
    margin: 6px 0 0;
    color: #617089;
    font-size: 11px;
    line-height: 1.55;
}

@media (max-width: 900px) {
    .import-upload-form,
    .import-map-grid {
        grid-template-columns: 1fr;
    }
}
.rules-layout {
    display: grid;
    grid-template-columns:
        minmax(320px, 0.8fr)
        minmax(500px, 1.2fr);
    align-items: start;
    gap: 18px;
}

.rules-card {
    padding: 24px;
    border: 1px solid #e5e9f1;
    border-radius: 20px;
    background: #ffffff;
    box-shadow:
        0 7px 24px rgba(31, 49, 84, 0.05);
}

.rules-heading {
    margin-bottom: 20px;
}

.rules-heading small {
    color: #8b95a7;
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
}

.rules-heading h2 {
    margin: 5px 0 0;
    font-size: 22px;
}

.rules-form-grid {
    display: grid;
    gap: 16px;
}

.rules-form-grid label {
    display: grid;
    gap: 7px;
}

.rules-form-grid label > span {
    color: #667085;
    font-size: 11px;
    font-weight: 800;
}

.rules-form-grid input {
    width: 100%;
    height: 44px;
    padding: 0 12px;
    border: 1px solid #dfe5ee;
    border-radius: 11px;
    outline: 0;
    font: inherit;
}

.rules-list {
    display: grid;
}

.rule-row {
    display: grid;
    grid-template-columns:
        minmax(0, 1fr)
        auto
        auto;
    align-items: center;
    gap: 18px;
    min-height: 72px;
    border-top: 1px solid #edf0f5;
}

.rule-row:first-child {
    border-top: 0;
}

.rule-row > div:first-child {
    display: flex;
    min-width: 0;
    flex-direction: column;
}

.rule-row strong {
    font-size: 12px;
}

.rule-row small {
    margin-top: 4px;
    color: #8c97aa;
    font-size: 10px;
}

.rule-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #667085;
    font-size: 9px;
}

.rule-meta span {
    padding: 5px 8px;
    border-radius: 999px;
    background: #eef1f6;
}

.rule-on {
    background: #e8f8f1 !important;
    color: #16875f;
}

.rule-off {
    background: #fff0f1 !important;
    color: #c74452;
}

.rule-actions {
    display: flex;
    align-items: center;
    gap: 9px;
}

.rule-actions form,
.inline-action-form {
    margin: 0;
}

.rule-actions a,
.rule-actions button {
    border: 0;
    background: transparent;
    color: #315efb;
    font: inherit;
    font-size: 10px;
    font-weight: 900;
    cursor: pointer;
}

.rule-actions button {
    color: #c74452;
}

.inline-action-form .secondary-button {
    height: 100%;
}

@media (max-width: 900px) {
    .rules-layout {
        grid-template-columns: 1fr;
    }

    .rule-row {
        grid-template-columns: 1fr;
    }
}
.save-rule-box {
    padding: 18px;
    border: 1px solid #dbe5ff;
    border-radius: 15px;
    background: #f4f7ff;
}

.rule-match-field {
    display: grid;
    gap: 7px;
    margin-top: 12px;
}

.rule-match-field > span {
    color: #667085;
    font-size: 11px;
    font-weight: 800;
}

.rule-match-field input {
    width: 100%;
    height: 43px;
    padding: 0 12px;
    border: 1px solid #dfe5ee;
    border-radius: 11px;
    font: inherit;
}

.needs-review-badge {
    display: inline-flex;
    margin-left: 6px;
    padding: 3px 6px;
    border-radius: 999px;
    background: #fff4dc;
    color: #9b6500;
    font-size: 8px;
    font-weight: 900;
}

.review-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 18px;
    padding: 13px 16px;
    border: 1px solid #f1dda9;
    border-radius: 12px;
    background: #fff9e9;
    color: #805900;
    font-size: 11px;
}

.review-summary span {
    color: #977737;
}

/* =========================================================
   COMPACT DASHBOARD DENSITY PASS
   Keeps the visual language, removes oversized UI spacing.
   ========================================================= */

.app-main {
    padding: 22px 28px;
}

.dashboard-header,
.transactions-header {
    margin-bottom: 18px;
}

.dashboard-header h1,
.transactions-header h1 {
    margin: 2px 0 4px;
    font-size: 27px;
    line-height: 1.15;
}

.app-greeting,
.transactions-subtitle {
    margin-bottom: 3px;
}


/* ---------- TOP TOOLBAR ---------- */

.dashboard-toolbar,
.dashboard-actions,
.transactions-actions {
    display: flex;
    align-items: center;
    gap: 8px;
}

#dashboard-plaid-sync {
    min-height: 36px;
    height: 36px;
    padding: 0 14px;
    border-radius: 8px;
    font-size: 11px;
    font-weight: 800;
}

#dashboard-sync-status {
    font-size: 10px !important;
    line-height: 1.2;
}

input[placeholder="Search transactions..."] {
    height: 36px;
    min-height: 36px;
    padding: 0 12px;
    border-radius: 8px;
    font-size: 11px;
}


/* ---------- SUMMARY CARDS ---------- */

.dashboard-summary-grid,
.transaction-summary-grid {
    gap: 10px;
    margin-bottom: 14px;
}

.summary-card,
.dashboard-summary-card,
.stat-card {
    min-height: 0;
    padding: 14px 16px;
    border-radius: 12px;
}

.summary-card small,
.dashboard-summary-card small,
.stat-card small {
    font-size: 9px;
    letter-spacing: .04em;
}

.summary-card strong,
.dashboard-summary-card strong,
.stat-card strong {
    margin-top: 4px;
    font-size: 22px;
    line-height: 1.05;
}

.summary-card p,
.dashboard-summary-card p,
.stat-card p {
    margin: 4px 0 0;
    font-size: 9px;
    line-height: 1.3;
}


/* ---------- MAIN DASHBOARD PANELS ---------- */

.dashboard-card,
.dashboard-panel,
.import-card,
.rules-card {
    padding: 16px 18px;
    border-radius: 13px;
}

.dashboard-grid,
.dashboard-content-grid {
    gap: 12px;
}

.dashboard-section-header,
.dashboard-card-header {
    margin-bottom: 10px;
}

.dashboard-section-header h2,
.dashboard-card-header h2,
.dashboard-card h2 {
    margin: 0;
    font-size: 15px;
}

.dashboard-section-header p,
.dashboard-card-header p {
    margin-top: 2px;
    font-size: 9px;
}


/* ---------- ACCOUNT / BILL / TRANSACTION ROWS ---------- */

.account-row,
.dashboard-account-row,
.transaction-row,
.dashboard-transaction-row,
.bill-row,
.dashboard-bill-row {
    min-height: 46px;
    padding-top: 8px;
    padding-bottom: 8px;
}

.account-row strong,
.dashboard-account-row strong,
.transaction-row strong,
.dashboard-transaction-row strong,
.bill-row strong,
.dashboard-bill-row strong {
    font-size: 11px;
}

.account-row small,
.dashboard-account-row small,
.transaction-row small,
.dashboard-transaction-row small,
.bill-row small,
.dashboard-bill-row small {
    font-size: 9px;
}


/* ---------- INITIAL / ICON BOXES ---------- */

.transaction-icon,
.account-icon,
.dashboard-icon {
    width: 30px;
    height: 30px;
    min-width: 30px;
    border-radius: 8px;
    font-size: 10px;
}


/* ---------- SPENDING BREAKDOWN ---------- */

.spending-row,
.spending-item {
    margin-bottom: 8px;
}

.spending-row strong,
.spending-item strong {
    font-size: 10px;
}

.spending-bar,
.progress-bar {
    height: 5px;
    border-radius: 999px;
}


/* ---------- BUTTONS ---------- */

.primary-button,
.secondary-button {
    min-height: 36px;
    padding: 0 13px;
    border-radius: 8px;
    font-size: 10px;
}


/* ---------- SIDEBAR: SLIGHTLY DENSER ---------- */

.app-sidebar nav a {
    min-height: 36px;
    padding-top: 8px;
    padding-bottom: 8px;
}

.app-sidebar nav {
    gap: 2px;
}


/* ---------- RESPONSIVE ---------- */

@media (max-width: 900px) {
    .app-main {
        padding: 18px;
    }

    .dashboard-toolbar,
    .dashboard-actions,
    .transactions-actions {
        flex-wrap: wrap;
    }
}


/* =========================================================
   DASHBOARD HEADER CONTROL ALIGNMENT
   ========================================================= */

/* The header action container that owns Sync + Search + Avatar */
*:has(> #dashboard-plaid-sync):has(> input[placeholder="Search transactions..."]) {
    display: flex !important;
    align-items: center !important;
    justify-content: flex-end !important;
    flex-wrap: nowrap !important;
    gap: 8px !important;
    width: auto !important;
    max-width: none !important;
}

/* Keep Sync Now compact and on one line */
#dashboard-plaid-sync {
    flex: 0 0 auto !important;
    width: auto !important;
    height: 36px !important;
    min-height: 36px !important;
    margin: 0 !important;
    padding: 0 13px !important;
    white-space: nowrap !important;
    line-height: 1 !important;
}

/* Search stays wide but no longer forces wrapping */
input[placeholder="Search transactions..."] {
    flex: 0 1 280px !important;
    width: 280px !important;
    max-width: 280px !important;
    margin: 0 !important;
}

/*
   Status is unnecessary while idle.
   Button already changes to Syncing... / Synced.
*/
#dashboard-sync-status {
    display: none !important;
}

@media (max-width: 900px) {
    *:has(> #dashboard-plaid-sync):has(> input[placeholder="Search transactions..."]) {
        flex-wrap: wrap !important;
    }

    input[placeholder="Search transactions..."] {
        flex: 1 1 220px !important;
        width: auto !important;
        max-width: none !important;
    }
}
/* BEGIN MONEY ALLOCATION */

.money-allocation {
    margin: 14px 0 18px;
    padding: 16px 18px;
    background: #fff;
    border: 1px solid #dde3ee;
    border-radius: 14px;
}

.money-allocation-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 12px;
}

.money-allocation-heading small {
    display: block;
    margin-bottom: 2px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .04em;
    opacity: .58;
}

.money-allocation-heading h2 {
    margin: 0;
    font-size: 18px;
}

.money-allocation-heading a {
    font-size: 12px;
    font-weight: 700;
    text-decoration: none;
}

.money-allocation-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    border-top: 1px solid #e7ebf2;
}

.money-allocation-item {
    display: block;
    min-width: 0;
    padding: 13px 16px 10px;
    border-right: 1px solid #e7ebf2;
    color: inherit;
    text-decoration: none;
}

.money-allocation-item:first-child {
    padding-left: 0;
}

.money-allocation-item:last-child {
    border-right: 0;
    padding-right: 0;
}

.money-allocation-item span {
    display: block;
    margin-bottom: 4px;
    font-size: 12px;
    font-weight: 700;
    opacity: .68;
}

.money-allocation-item strong {
    display: block;
    margin-bottom: 3px;
    font-size: 20px;
    line-height: 1.15;
}

.money-allocation-item small {
    display: block;
    font-size: 11px;
    opacity: .56;
}

.money-allocation-item:hover strong {
    text-decoration: underline;
}

@media (max-width: 900px) {

    .money-allocation-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .money-allocation-item,
    .money-allocation-item:first-child,
    .money-allocation-item:last-child {
        padding: 12px;
        border-right: 0;
        border-bottom: 1px solid #e7ebf2;
    }

    .money-allocation-item:last-child {
        border-bottom: 0;
    }
}

/* END MONEY ALLOCATION */

/* ============================================================
   Money Allocation width correction
   ============================================================ */

.money-allocation {
    width: 100% !important;
    max-width: none !important;
    box-sizing: border-box !important;
}

.money-allocation-heading {
    width: 100% !important;
}

.money-allocation-grid {
    width: 100% !important;
    display: grid !important;
    grid-template-columns:
        1.1fr
        1.1fr
        1fr
        1.25fr
        1.25fr !important;
}

.money-allocation-item {
    min-width: 0 !important;
    padding: 10px 18px !important;
}

.money-allocation-item:first-child {
    padding-left: 4px !important;
}

.money-allocation-item:last-child {
    padding-right: 4px !important;
}

.money-allocation-item strong {
    font-size: 18px !important;
}

.money-allocation-item small {
    font-size: 10px !important;
    white-space: normal !important;
}

/* ============================================================
   Force Money Allocation full dashboard span
   ============================================================ */

.money-allocation {
    grid-column: 1 / -1 !important;
    width: 100% !important;
    max-width: none !important;
    justify-self: stretch !important;
    align-self: stretch !important;
}

.money-allocation-grid {
    width: 100% !important;
    grid-template-columns:
        repeat(5, minmax(0, 1fr)) !important;
}

.money-allocation-item {
    width: 100% !important;
    box-sizing: border-box !important;
}
